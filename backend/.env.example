# SANTOS DUMONT REFECTORY API
# Arquivo de exemplo — não inserir credenciais reais aqui

NODE_ENV=staging

# O Render fornece PORT automaticamente.
# Para execução local, pode ser usada a porta abaixo.
PORT=10000

# Supabase exclusivo de staging
SUPABASE_URL=https://seu-project-ref-de-staging.supabase.co
SUPABASE_ANON_KEY=cole-a-chave-publica-apenas-no-env-local-ou-render
SUPABASE_SERVICE_ROLE_KEY=cole-a-chave-secreta-apenas-no-env-local-ou-render

# Origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:3000